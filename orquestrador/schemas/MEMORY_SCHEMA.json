{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Orquestrador Maestro Observation",
  "description": "Schema for episodic memory observations",
  "type": "object",
  "required": ["schemaVersion", "id", "timestamp", "project", "type", "summary"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "enum": [1],
      "description": "Schema version"
    },
    "id": {
      "type": "string",
      "pattern": "^obs_[a-f0-9]{16}$",
      "description": "Unique observation ID"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp"
    },
    "project": {
      "type": "string",
      "description": "Project identifier"
    },
    "taskId": {
      "type": "string",
      "description": "Optional task identifier"
    },
    "type": {
      "type": "string",
      "enum": [
        "decision",
        "discovery",
        "problem",
        "attempt",
        "failure",
        "implementation",
        "verification",
        "risk",
        "dependency",
        "environment",
        "workaround"
      ],
      "description": "Observation type"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Short summary of the observation"
    },
    "details": {
      "type": "string",
      "description": "Detailed explanation"
    },
    "files": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Related files"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Searchable tags"
    },
    "verified": {
      "type": "boolean",
      "default": false,
      "description": "Whether this observation has been verified"
    },
    "source": {
      "type": "object",
      "properties": {
        "tool": { "type": "string" },
        "session": { "type": "string" },
        "commit": { "type": "string" }
      },
      "description": "Source context"
    },
    "scope": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": ["repository", "workspace", "branch"],
          "description": "Scope level"
        },
        "branch": { "type": "string" },
        "workspaceId": { "type": "string" },
        "repositoryId": { "type": "string" }
      },
      "required": ["level"],
      "description": "Observation scope"
    },
    "branch": {
      "type": "string",
      "description": "Git branch (for branch-scoped observations)"
    },
    "workspaceId": {
      "type": "string",
      "description": "Workspace identifier"
    },
    "capturePolicy": {
      "type": "string",
      "enum": ["ALLOW", "REDACT", "METADATA_ONLY", "DROP"],
      "description": "Capture policy applied to this observation"
    }
  }
}